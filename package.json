{
  "name": "lomboktemplate",
  "version": "0.1.0",
  "description": "Logic-less templates: Mustache sections, Handlebars-style blocks and helpers, Liquid-style filters. HTML escaping by default, no code evaluation, bounded nesting. Zero dependencies.",
  "keywords": ["template", "mustache", "handlebars", "liquid", "html", "escaping", "zero-dependency", "lombok-ecosystem"],
  "license": "Apache-2.0",
  "author": "codinglombok (https://github.com/codinglombok)",
  "repository": { "type": "git", "url": "https://github.com/codinglombok/LombokTemplate.git" },
  "homepage": "https://github.com/codinglombok/LombokTemplate",
  "bugs": { "url": "https://github.com/codinglombok/LombokTemplate/issues" },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "vectors": "python3 vectors/build_vectors.py",
    "doctor": "bash scripts/lombok-doctor.sh LombokTemplate",
    "check": "npm run lint && npm run coverage && npm run build && npm run doctor"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
